# Safe example values only. Copy this file to .env for local overrides.
# Never commit credentials or real secrets.

EKA_APP_NAME=Enterprise Knowledge and Analytics Agent
EKA_ENVIRONMENT=development
EKA_LOG_LEVEL=INFO
EKA_DEBUG=false
EKA_REQUEST_TIMEOUT_SECONDS=30
EKA_MAX_REQUEST_BYTES=1048576

# Local PostgreSQL container
POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent_admin
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=55432

# SQLAlchemy connection from applications running directly on the Mac
EKA_DATABASE_URL=postgresql+psycopg://enterprise_agent_admin:local_dev_only_change_me@localhost:55432/enterprise_agent
EKA_DATABASE_ECHO=false